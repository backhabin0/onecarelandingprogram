# Supabase Dashboard > Project Settings > API 에서 확인할 수 있다.
# 이 파일을 복사해 .env.local 로 저장한 뒤 실제 값을 입력한다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 11단계: SEO / canonical / sitemap / robots / Open Graph URL 생성 기준이 되는
# 사이트 기본 URL. 로컬 개발은 http://localhost:3000, Vercel 배포는 실제
# 배포 도메인(https://xxxxx.vercel.app), 정식 도메인 연결 후에는
# https://example.co.kr 처럼 값만 바꾸면 전체 SEO URL이 함께 바뀐다.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 11단계: Google Search Console / 네이버 서치어드바이저 사이트 소유권 확인용
# 토큰. 값이 없으면 해당 verification meta 태그 자체가 생성되지 않는다.
# (이번 단계에서는 실제 등록을 하지 않으므로 비워둬도 된다)
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# 14단계: 상담 신청 접수 시 관리자에게 보내는 이메일 알림(Resend API).
# 셋 중 하나라도 비어 있으면 이메일 전송만 건너뛰고 상담 신청 자체(DB 저장)는
# 정상 동작한다 — 로컬 개발에서는 비워둬도 된다. 실제 값은 절대 커밋하지 않는다.
RESEND_API_KEY=
CONSULTATION_NOTIFICATION_EMAIL=
CONSULTATION_FROM_EMAIL=
